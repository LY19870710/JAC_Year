# JAC Year Manager — Production Environment Variables
# Copy this file to .env and configure

# Server binding (0.0.0.0 = accept external connections)
HOST=0.0.0.0

# Server port
PORT=3000

# Node environment
NODE_ENV=production

# Database path (SQLite file)
DB_PATH=./jac_articles.db

# Log level: error | warn | info | http | verbose | debug
# LOG_LEVEL=info

# Max articles per search result
# MAX_RESULTS=500
